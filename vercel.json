{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python build.py",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "{model_artifacts/**,templates/**,flight_price_prediction.csv}",
      "excludeFiles": "{tests/**,screenshots/**,docs/**,static/**}"
    }
  }
}
